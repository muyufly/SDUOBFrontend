{
  "name": "sdu-online-blog-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host localhost --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host localhost --port 5173 --strictPort",
    "typecheck": "tsc -b",
    "api:types": "openapi-typescript api/openapi.json -o src/api/schema.d.ts",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/noto-sans-sc": "5.3.1",
    "@fontsource/noto-serif-sc": "5.3.1",
    "@hookform/resolvers": "6.0.0",
    "@tanstack/react-query": "5.104.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "0.5.0",
    "dompurify": "3.4.17",
    "lucide-react": "1.61.0",
    "markdown-it": "15.0.3",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "react-router-dom": "7.18.4",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/markdown-it": "14.2.0",
    "@types/node": "24.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
